+
+    def test_connects_clustered_graph(self):
+        xb = clustered_vectors(self.n + 200, self.d, self.nclusters, 0.3, 1)
+        xb, xq = xb[: self.n], xb[self.n:]
+        x = np.ascontiguousarray(xb)
