# Mend (WhiteSource) Unified Agent configuration, used because .whitesource sets configMode to LOCAL.
# Resolve Python dependencies with Python 3.11 (the version the project uses) instead of Mend's
# default, so that patched releases requiring Python >= 3.11 (e.g. matplotlib 3.11, starlette 1.x)
# are resolved.
python.resolveDependencies=true
python.invokePipAsModule=true
python.path=python3.11
python.installVirtualenv=true
python.ignoreSourceFiles=true
